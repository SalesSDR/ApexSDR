# =============================================================================
# Apex SDR — Apache/Hostinger Rewrite Rules
# Generated for Next.js static export (output: 'export')
# =============================================================================

# ── HTTPS Enforcement ────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Strip www → non-www (apexsdr.com canonical)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ── Clean URLs (remove .html extension) ──────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Skip if the request already matches a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # If a .html version of the path exists, serve it transparently
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── Trailing Slash Normalization ──────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [R=301,L]
</IfModule>

# ── Custom Error Pages ────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS (force HTTPS for 1 year after first visit)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Static Asset Caching ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Next.js hashed assets (_next/static) — cache forever
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  # HTML pages — always revalidate
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control for hashed Next.js chunks
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>
