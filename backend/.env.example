# Copy to .env.production (or export these directly) and fill in real values
# before deploying. Fields marked REQUIRED IN PRODUCTION are enforced by
# app/config.py's validate_production_secrets(): the app refuses to start
# with ENVIRONMENT=production if any of them are missing. They are optional
# in development/test - mock mode does not need real values for any of them.

# --- Core ---
ENVIRONMENT=production
DATABASE_ASYNC_URL=postgresql+asyncpg://user:password@localhost:5432/apexsdr
REDIS_URL=redis://:password@localhost:6379/0

# Comma-separated frontend origins allowed to call this API with credentials
# (see app/main.py's CORSMiddleware setup). Falls back to a localhost/Vercel-
# preview list if unset - always set this explicitly in production.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# REQUIRED IN PRODUCTION - JWT signing key for API authentication
# (app.core.security.JWTAuthProvider). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_signing_secret

# Static API-key registry for server-to-server auth: "key1:tenant_a,key2:tenant_b"
TENANT_API_KEYS=

# --- Unipile (LinkedIn) ---
UNIPILE_API_KEY=your_unipile_api_key
UNIPILE_BASE_URL=https://api.unipile.com/api/v1
UNIPILE_ACCOUNT_ID=your_unipile_account_id
# REQUIRED IN PRODUCTION - verifies the `Unipile-Auth` header Unipile sends
# back on every webhook delivery.
UNIPILE_WEBHOOK_SECRET=your_unipile_webhook_secret

# --- Resend (email) ---
RESEND_API_KEY=your_resend_api_key
RESEND_SENDER_EMAIL=onboarding@resend.dev
# REQUIRED IN PRODUCTION - verifies Resend's inbound-email webhook signature
# (delivered via Svix). See resend.com/docs/webhooks/verify-webhooks-requests.
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# --- Twilio (voice) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
# REQUIRED IN PRODUCTION - verifies inbound Twilio webhook signatures.
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number

# --- Voice AI conversation pipeline (Sprint 7) ---
# Speech-to-Text (Deepgram) and Text-to-Speech (ElevenLabs). Neither is in
# the required-production-secrets list above - USE_MOCK_CLIENTS below gates
# provider selection the same way every other adapter pair does.
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Google Calendar ---
GOOGLE_CLIENT_ID=your_google_client_id
# REQUIRED IN PRODUCTION - OAuth client secret for Google Calendar booking.
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# --- HubSpot CRM ---
# REQUIRED IN PRODUCTION - deal-stage sync (Sprint 6) fails closed without it.
HUBSPOT_API_KEY=your_hubspot_api_key

# --- Apollo / enrichment waterfall ---
APOLLO_API_KEY=your_apollo_api_key
PROSPEO_API_KEY=your_prospeo_api_key
KASPR_API_KEY=your_kaspr_api_key
CONTACTOUT_API_KEY=your_contactout_api_key

# --- Gemini (AI message generation) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Safety limits ---
MAX_LINKEDIN_INVITES_PER_DAY=20
GLOBAL_MAX_RETRY_ATTEMPTS=5

# --- Testing & dev ---
# USE_MOCK_CLIENTS=true swaps every external provider for its mock
# implementation - never set this in production.
USE_MOCK_CLIENTS=false
